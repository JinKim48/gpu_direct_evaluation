# vLLM 0.30.0 built against CUDA 12.9 / torch 2.13.0+cu129.
# The published v0.30.0-cu129 tag ships torch 2.14.0+cu130 and cannot
# initialize on host driver 570.86.10. This image keeps that torch pin.

FROM nvidia/cuda:12.9.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    HTTP_PROXY=http://10.8.6.103:8118 \
    HTTPS_PROXY=http://10.8.6.103:8118 \
    NO_PROXY=localhost,127.0.0.1 \
    http_proxy=http://10.8.6.103:8118 \
    https_proxy=http://10.8.6.103:8118 \
    no_proxy=localhost,127.0.0.1 \
    CUDA_HOME=/usr/local/cuda \
    PATH=/opt/venv/bin:/usr/local/cuda/bin:${PATH} \
    MAX_JOBS=32 \
    NVCC_THREADS=2 \
    CMAKE_BUILD_PARALLEL_LEVEL=32 \
    TORCH_CUDA_ARCH_LIST=9.0 \
    VLLM_VERSION_OVERRIDE=0.30.0 \
    SETUPTOOLS_SCM_PRETEND_VERSION=0.30.0 \
    VLLM_TARGET_DEVICE=cuda

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-dev \
        python3-venv \
        python3-pip \
        build-essential \
        cmake \
        ninja-build \
        git \
        wget \
        ca-certificates \
        pkg-config \
        libnuma-dev \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv \
    && pip install --no-cache-dir --upgrade pip setuptools wheel

# Install torch before vLLM so a later resolver cannot replace it with cu130.
RUN pip install --no-cache-dir \
        torch==2.13.0 torchvision==0.28.0 torchaudio==2.11.0 \
        --index-url https://download.pytorch.org/whl/cu129 \
    && python3 -c "import torch; v=torch.__version__; assert '+cu129' in v, v; print(v)"

WORKDIR /workspace/vllm
COPY src/vllm /workspace/vllm

RUN apt-get update && apt-get install -y --no-install-recommends libdw-dev libelf-dev \
    && rm -rf /var/lib/apt/lists/* \
    && printf '%s\n' \
        'torch==2.13.0+cu129' \
        'torchvision==0.28.0+cu129' \
        'torchaudio==2.11.0+cu129' \
        > /tmp/torch-constraint.txt \
    && python3 use_existing_torch.py --prefix \
    && sed -i 's/^nvidia-cutlass-dsl\[cu13\]/nvidia-cutlass-dsl/' requirements/cuda.txt \
    && sed -i 's/^humming-kernels\[cu13\]/humming-kernels[cu12]/' requirements/cuda.txt \
    && pip install --no-cache-dir \
        -c /tmp/torch-constraint.txt \
        -r requirements/cuda.txt \
        --index-url https://download.pytorch.org/whl/cu129 \
        --extra-index-url https://pypi.org/simple \
    && python3 -c "import torch; assert '+cu129' in torch.__version__, torch.__version__; print('torch-kept', torch.__version__)" \
    && pip install --no-cache-dir \
        'setuptools>=77.0.3,<81' \
        'setuptools-rust>=1.9.0' \
        'setuptools-scm>=8' \
        packaging \
        jinja2

ENV VLLM_FLASH_ATTN_SRC_DIR=/opt/src/flash-attention \
    GIT_TERMINAL_PROMPT=0
RUN git config --global http.version HTTP/1.1 \
    && git config --global http.postBuffer 524288000 \
    && git config --global advice.detachedHead false \
    && rm -rf /opt/src/flash-attention \
    && git clone https://github.com/vllm-project/flash-attention.git /opt/src/flash-attention \
    && git -C /opt/src/flash-attention fetch --depth 1 origin 506341a143fcabd4bb79052a7605ada727d6b3f5 \
    && git -C /opt/src/flash-attention checkout FETCH_HEAD \
    && ok=0 \
    && for i in 1 2 3 4 5; do \
        git -C /opt/src/flash-attention submodule update --init --depth 1 csrc/cutlass && ok=1 && break; \
        sleep 20; \
    done \
    && test "$ok" = 1 \
    && test -d /opt/src/flash-attention/csrc/cutlass/include \
    && pip install --no-cache-dir --no-build-isolation \
        -c /tmp/torch-constraint.txt \
        . \
    && python3 -c "import torch, vllm; assert '+cu129' in torch.__version__, torch.__version__; print('vllm', vllm.__version__); print('torch', torch.__version__)"

ARG LMCACHE_WHEEL=lmcache-0.5.5-cp312-cp312-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl
COPY build/${LMCACHE_WHEEL} /tmp/${LMCACHE_WHEEL}
RUN pip install --no-cache-dir --no-deps /tmp/${LMCACHE_WHEEL} \
    && rm -f /tmp/${LMCACHE_WHEEL} \
    && python3 -c "import importlib.metadata as m; print('vllm=' + m.version('vllm')); print('torch=' + m.version('torch')); print('lmcache=' + m.version('lmcache')); import torch; assert '+cu129' in torch.__version__, torch.__version__; import lmcache"

WORKDIR /workspace
ENTRYPOINT ["python3"]
